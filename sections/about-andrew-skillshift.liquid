{% comment %}
  About Andrew Section - SkillShift Custom
  
  Displays instructor bio with:
  - Professional headshot
  - Personal story and background
  - Key credentials and certifications
  - Achievement stats
  - Social proof elements
  - Call-to-action buttons
{% endcomment %}

<section class="about-instructor">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    <div class="about-content">
      <div class="about-image-column">
        {%- if section.settings.image != blank -%}
          <div class="about-image-wrapper">
            {{ section.settings.image | image_url: width: 500 | image_tag: class: 'about-image' }}
          </div>
        {%- endif -%}
        
        {%- if section.blocks.size > 0 -%}
          <div class="about-stats">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="about-stat" {{ block.shopify_attributes }}>
                  <div class="about-stat-number">{{ block.settings.number }}</div>
                  <div class="about-stat-label">{{ block.settings.label }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      
      <div class="about-text-column">
        {%- if section.settings.name != blank -%}
          <h3 class="about-name">{{ section.settings.name }}</h3>
        {%- endif -%}
        
        {%- if section.settings.title != blank -%}
          <p class="about-title">{{ section.settings.title }}</p>
        {%- endif -%}
        
        {%- if section.settings.bio != blank -%}
          <div class="about-bio">
            {{ section.settings.bio }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.credentials != blank -%}
          <div class="about-credentials">
            <h4 class="credentials-heading">
              <i class="fas fa-certificate"></i>
              Credentials & Expertise
            </h4>
            <div class="credentials-content">
              {{ section.settings.credentials }}
            </div>
          </div>
        {%- endif -%}
        
        {%- if section.blocks.size > 0 -%}
          <div class="about-achievements">
            {%- for block in section.blocks -%}
              {%- if block.type == 'achievement' -%}
                <div class="achievement-badge" {{ block.shopify_attributes }}>
                  <i class="fas fa-{{ block.settings.icon }}"></i>
                  <span>{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        
        {%- if section.settings.primary_cta_text != blank or section.settings.secondary_cta_text != blank -%}
          <div class="about-ctas">
            {%- if section.settings.primary_cta_text != blank -%}
              <a href="{{ section.settings.primary_cta_link }}" class="btn btn-primary">
                {{ section.settings.primary_cta_text }}
              </a>
            {%- endif -%}
            
            {%- if section.settings.secondary_cta_text != blank -%}
              <a href="{{ section.settings.secondary_cta_link }}" class="btn btn-outline">
                {{ section.settings.secondary_cta_text }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .about-instructor {
    padding: var(--spacing-xl) 0;
    background: white;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--spacing-xl);
    align-items: start;
    margin-top: var(--spacing-lg);
  }

  .about-image-column {
    position: sticky;
    top: var(--spacing-lg);
  }

  .about-image-wrapper {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--spacing-lg);
  }

  .about-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .about-stat {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    text-align: center;
    color: white;
  }

  .about-stat-number {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--spacing-xs);
  }

  .about-stat-label {
    font-size: 0.875rem;
    opacity: 0.95;
  }

  .about-text-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .about-name {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .about-title {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0;
  }

  .about-bio {
    color: var(--color-body);
    line-height: 1.7;
    font-size: 1.0625rem;
  }

  .about-bio p {
    margin-bottom: var(--spacing-md);
  }

  .about-bio p:last-child {
    margin-bottom: 0;
  }

  .about-credentials {
    background: var(--color-surface);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-accent);
  }

  .credentials-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-sm) 0;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .credentials-heading i {
    color: var(--color-accent);
  }

  .credentials-content {
    color: var(--color-body);
    line-height: 1.6;
  }

  .credentials-content p {
    margin: 0;
  }

  .about-achievements {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .achievement-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: white;
    border: 2px solid var(--color-accent);
    color: var(--color-primary);
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all var(--transition-base);
  }

  .achievement-badge:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-2px);
  }

  .achievement-badge i {
    color: var(--color-accent);
    transition: color var(--transition-base);
  }

  .achievement-badge:hover i {
    color: white;
  }

  .about-ctas {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  @media (max-width: 968px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .about-image-column {
      position: static;
    }

    .about-stats {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }

    .about-ctas {
      flex-direction: column;
    }

    .about-ctas .btn {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
