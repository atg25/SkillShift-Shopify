{% comment %}
  CTA Section - SkillShift Custom
  
  Displays a compelling call-to-action with:
  - Dark overlay for high contrast
  - Optional background image
  - Headline and supporting text
  - Dual CTAs
  - Trust guarantee message
{% endcomment %}

<section 
  class="cta dark-context"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
  {% else %}
    style="background: var(--gradient-section);"
  {% endif %}
>
  <div class="container">
    <div class="cta-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="cta-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.subtitle != blank -%}
        <p class="cta-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      
      {%- if section.settings.primary_cta_text != blank or section.settings.secondary_cta_text != blank -%}
        <div class="cta-buttons">
          {%- if section.settings.primary_cta_text != blank -%}
            <a href="{{ section.settings.primary_cta_link }}" class="btn btn-primary">
              {{ section.settings.primary_cta_text }}
            </a>
          {%- endif -%}
          
          {%- if section.settings.secondary_cta_text != blank -%}
            <a href="{{ section.settings.secondary_cta_link }}" class="btn btn-outline">
              {{ section.settings.secondary_cta_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.guarantee_text != blank -%}
        <p class="cta-guarantee">
          <i class="fas fa-{{ section.settings.guarantee_icon }}"></i>
          {{ section.settings.guarantee_text }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Section - SkillShift",
  "tag": "section",
  "class": "section-cta",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Ready to Transform Your Career?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Supporting Text",
      "default": "Join thousands of professionals who've already started their journey to success"
    },
    {
      "type": "header",
      "content": "Call to Action Buttons"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Get Started Today"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button Link",
      "default": "/pages/about"
    },
    {
      "type": "header",
      "content": "Trust Message"
    },
    {
      "type": "text",
      "id": "guarantee_icon",
      "label": "Guarantee Icon",
      "default": "check-circle",
      "info": "Font Awesome icon name without 'fa-' prefix. Examples: check-circle, shield-alt, lock, clock"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "30-Day Money-Back Guarantee • No Risk"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Optional)",
      "info": "If no image is selected, a navy gradient will be used"
    }
  ],
  "presets": [
    {
      "name": "CTA Section - SkillShift",
      "category": "CTA"
    }
  ]
}
{% endschema %}
