{% comment %}
  Hero Section - SkillShift Custom
  
  Displays a compelling hero banner with:
  - Powerful headline and subtitle
  - Dual CTAs (primary + secondary)
  - Trust badges with icons
  - Optional background image
  - Navy gradient with glass morphism aesthetic
{% endcomment %}

<section 
  class="hero dark-context"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
  {% endif %}
>
  <div class="hero-content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    
    {%- if section.settings.subtitle != blank -%}
      <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    
    {%- if section.settings.primary_cta_text != blank or section.settings.secondary_cta_text != blank -%}
      <div class="hero-buttons">
        {%- if section.settings.primary_cta_text != blank -%}
          <a href="{{ section.settings.primary_cta_link }}" class="btn btn-primary">
            {{ section.settings.primary_cta_text }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.secondary_cta_text != blank -%}
          <a href="{{ section.settings.secondary_cta_link }}" class="btn btn-outline">
            {{ section.settings.secondary_cta_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- if section.settings.show_trust_badges -%}
      <div class="hero-trust-badges flex gap-xl justify-center flex-wrap" style="margin-top: var(--space-xl);">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'trust_badge' -%}
              <div class="trust-badge flex items-center gap-sm" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <i class="fas fa-{{ block.settings.icon }}" style="color: var(--sky-blue); font-size: var(--text-lg);"></i>
                {%- endif -%}
                <span style="color: var(--white); font-weight: var(--font-weight-medium); font-size: var(--text-sm);">
                  {{ block.settings.text }}
                </span>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero - SkillShift",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Transform Your Career with Expert Training",
      "info": "Keep it under 10 words for maximum impact"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join 5,000+ professionals who've accelerated their careers with our industry-leading courses and 1-on-1 coaching",
      "info": "Highlight social proof and what makes you different"
    },
    {
      "type": "header",
      "content": "Call to Action Buttons"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Browse Courses"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "How It Works"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button Link",
      "default": "/pages/how-it-works"
    },
    {
      "type": "header",
      "content": "Trust Badges"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true,
      "info": "Display trust indicators below the CTA buttons"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Optional)",
      "info": "Use a high-quality image. The navy gradient overlay will maintain text readability."
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Font Awesome Icon",
          "default": "users",
          "info": "Enter icon name without 'fa-' prefix. Examples: users, graduation-cap, certificate, star, check-circle"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "5,000+ Students"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero - SkillShift",
      "category": "Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "users",
            "text": "5,000+ Students"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "graduation-cap",
            "text": "Expert Instructors"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "certificate",
            "text": "Career Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
