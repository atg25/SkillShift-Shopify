{% comment %}
  Services Grid - SkillShift Custom
  
  Displays services or courses in a responsive grid with:
  - Icon badges
  - Pricing
  - Feature lists
  - Call-to-action buttons
{% endcomment %}

<section class="section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="text-center mb-3xl">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="section-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="grid grid-auto-fit gap-xl">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'service_card' -%}
            <div class="card" {{ block.shopify_attributes }}>
              {%- if block.settings.badge_text != blank -%}
                <div style="position: absolute; top: var(--space-md); right: var(--space-md); background: var(--mint-green); color: var(--navy-deep); padding: 0.375rem 0.875rem; border-radius: var(--radius-full); font-size: 0.8125rem; font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 2px 8px rgba(77, 227, 200, 0.4); z-index: 2;">
                  {{ block.settings.badge_text }}
                </div>
              {%- endif -%}
              
              {%- if block.settings.icon != blank -%}
                <div class="icon-badge icon-badge-md">
                  <i class="fas fa-{{ block.settings.icon }}"></i>
                </div>
              {%- endif -%}
              
              <h3 style="font-size: clamp(1.25rem, 2.5vw, 1.5rem); font-weight: var(--font-weight-extrabold); color: var(--navy-deep); margin-bottom: var(--space-md); text-align: center; letter-spacing: -0.02em; line-height: 1.2;">
                {{ block.settings.title }}
              </h3>
              
              {%- if block.settings.price != blank -%}
                <p style="font-size: clamp(2rem, 4vw, 2.5rem); font-weight: var(--font-weight-extrabold); color: var(--mint-green); text-align: center; margin-bottom: var(--space-lg); letter-spacing: -0.02em; line-height: 1;">
                  {{ block.settings.price }}
                </p>
              {%- endif -%}
              
              {%- if block.settings.description != blank -%}
                <p style="font-size: 1.0625rem; color: var(--card-text); line-height: 1.6; margin-bottom: var(--space-lg); text-align: center;">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}
              
              {%- if block.settings.features != blank -%}
                {%- assign features = block.settings.features | split: '|' -%}
                <ul style="list-style: none; margin: var(--space-lg) 0 var(--space-xl) 0; padding: 0; width: 100%; text-align: left;">
                  {%- for feature in features -%}
                    <li style="padding: 0.5rem 0; display: flex; align-items: flex-start; gap: var(--space-md); color: var(--card-text); line-height: 1.5; font-size: 1rem;">
                      <span style="color: var(--mint-green); font-weight: var(--font-weight-extrabold); font-size: 1.25rem; flex-shrink: 0;">✓</span>
                      {{ feature | strip }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              
              {%- if block.settings.button_text != blank -%}
                <a 
                  href="{{ block.settings.button_link }}" 
                  class="btn btn-primary" 
                  style="width: 100%; justify-content: center; margin-top: var(--space-md);"
                  data-track="course-enroll-click"
                  data-course="{{ block.settings.title | handleize }}"
                  data-price="{{ block.settings.price }}"
                  aria-label="Enroll in {{ block.settings.title }}"
                >
                  {{ block.settings.button_text }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services Grid",
  "tag": "section",
  "class": "section-services",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Choose Your Path to Success"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Select the perfect course package for your career goals"
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service Card",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (Optional)",
          "info": "e.g., 'POPULAR', 'BEST VALUE', 'NEW'"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Font Awesome Icon",
          "default": "rocket",
          "info": "Enter icon name without 'fa-' prefix. Examples: rocket, code, chart-line, graduation-cap"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Professional Development"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$299",
          "info": "Include currency symbol"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Perfect for professionals looking to advance their careers"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "default": "10 Expert-Led Courses|1-on-1 Career Coaching|Lifetime Access|Certificate of Completion",
          "info": "Separate features with | character"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Get Started"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Grid - SkillShift",
      "category": "Services",
      "blocks": [
        {
          "type": "service_card",
          "settings": {
            "icon": "rocket",
            "title": "Starter Package",
            "price": "$149",
            "description": "Perfect for beginners starting their journey",
            "features": "5 Core Courses|Email Support|90 Days Access|Digital Certificate",
            "button_text": "Get Started"
          }
        },
        {
          "type": "service_card",
          "settings": {
            "badge_text": "POPULAR",
            "icon": "star",
            "title": "Professional",
            "price": "$299",
            "description": "Our most popular choice for career advancement",
            "features": "10 Expert-Led Courses|1-on-1 Career Coaching|Lifetime Access|Certificate of Completion",
            "button_text": "Get Started"
          }
        },
        {
          "type": "service_card",
          "settings": {
            "badge_text": "BEST VALUE",
            "icon": "crown",
            "title": "Enterprise",
            "price": "$499",
            "description": "Complete solution for serious professionals",
            "features": "All Courses + Future Releases|Dedicated Coach|Priority Support|Job Placement Assistance",
            "button_text": "Get Started"
          }
        }
      ]
    }
  ]
}
{% endschema %}
