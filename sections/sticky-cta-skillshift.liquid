{% doc %}
  Sticky CTA Bar - SkillShift Custom
  
  Fixed bottom bar that appears after user scrolls:
  - Course information
  - Price display
  - CTA button
  - Urgency indicator (optional)
{% enddoc %}

<div 
  class="sticky-cta-bar" 
  id="sticky-cta" 
  data-scroll-threshold="{{ section.settings.scroll_threshold | default: 800 }}"
  aria-hidden="true"
>
  <div class="sticky-cta-content">
    <div class="sticky-cta-info">
      {%- if section.settings.product_title != blank -%}
        <span class="sticky-product-title">{{ section.settings.product_title }}</span>
      {%- endif -%}
      
      {%- if section.settings.show_urgency -%}
        <span class="sticky-urgency">
          <i class="fas fa-{{ section.settings.urgency_icon }}"></i>
          {{ section.settings.urgency_text }}
        </span>
      {%- endif -%}
    </div>
    
    <div class="sticky-cta-action">
      {%- if section.settings.show_price -%}
        <div class="sticky-price">
          {%- if section.settings.compare_price != blank -%}
            <span class="sticky-price-original">{{ section.settings.compare_price }}</span>
          {%- endif -%}
          <span class="sticky-price-sale">{{ section.settings.price }}</span>
        </div>
      {%- endif -%}
      
      <a 
        href="{{ section.settings.cta_link }}" 
        class="btn btn-primary sticky-cta-button"
        data-track="sticky-cta-click"
        data-location="sticky-bar"
        aria-label="{{ section.settings.cta_text }}"
      >
        {{ section.settings.cta_text }}
      </a>
    </div>
    
    <button 
      class="sticky-close" 
      onclick="document.getElementById('sticky-cta').style.display='none'"
      aria-label="Close sticky bar"
    >
      <i class="fas fa-times"></i>
    </button>
  </div>
</div>

{% stylesheet %}
  .sticky-cta-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--navy-deep);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    z-index: 998;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-smooth);
  }

  .sticky-cta-bar.visible {
    transform: translateY(0);
  }

  .sticky-cta-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-md) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .sticky-cta-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sticky-product-title {
    font-size: 1.125rem;
    font-weight: var(--font-weight-bold);
    color: var(--white);
  }

  .sticky-urgency {
    font-size: 0.875rem;
    color: var(--mint-green);
    font-weight: var(--font-weight-medium);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .sticky-urgency i {
    animation: pulse-icon 2s ease-in-out infinite;
  }

  @keyframes pulse-icon {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .sticky-cta-action {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .sticky-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .sticky-price-original {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: line-through;
  }

  .sticky-price-sale {
    font-size: 1.5rem;
    font-weight: var(--font-weight-extrabold);
    color: var(--mint-green);
    line-height: 1;
  }

  .sticky-cta-button {
    white-space: nowrap;
    padding: 0.75rem 2rem;
    font-size: 1rem;
  }

  .sticky-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: var(--space-sm);
    font-size: 1.25rem;
    transition: color var(--transition-base);
  }

  .sticky-close:hover {
    color: var(--white);
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .sticky-cta-content {
      padding: var(--space-md);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .sticky-cta-info,
    .sticky-cta-action {
      width: 100%;
    }

    .sticky-cta-action {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .sticky-price {
      align-items: flex-start;
    }

    .sticky-cta-button {
      width: 100%;
      justify-content: center;
    }

    .sticky-close {
      position: absolute;
      top: var(--space-sm);
      right: var(--space-sm);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const stickyBar = document.getElementById('sticky-cta');
    if (!stickyBar) return;
    
    const scrollThreshold = parseInt(stickyBar.dataset.scrollThreshold) || 800;
    let isVisible = false;
    
    function checkScroll() {
      const scrollPosition = window.scrollY;
      
      if (scrollPosition > scrollThreshold && !isVisible) {
        stickyBar.classList.add('visible');
        stickyBar.setAttribute('aria-hidden', 'false');
        isVisible = true;
      } else if (scrollPosition <= scrollThreshold && isVisible) {
        stickyBar.classList.remove('visible');
        stickyBar.setAttribute('aria-hidden', 'true');
        isVisible = false;
      }
    }
    
    // Throttle scroll events
    let ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          checkScroll();
          ticking = false;
        });
        ticking = true;
      }
    });
    
    // Initial check
    checkScroll();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Sticky CTA Bar - SkillShift",
  "tag": "div",
  "class": "section-sticky-cta",
  "settings": [
    {
      "type": "header",
      "content": "Product Information"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Full-Stack Web Development Course"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "price",
      "label": "Sale Price",
      "default": "$299"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Original Price (Optional)",
      "default": "$499",
      "info": "Leave blank to hide"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Enroll Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Urgency Indicator"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show Urgency Message",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_icon",
      "label": "Urgency Icon",
      "default": "fire",
      "info": "Font Awesome icon name (without fa- prefix)"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Text",
      "default": "Only 7 spots left at this price"
    },
    {
      "type": "header",
      "content": "Behavior Settings"
    },
    {
      "type": "range",
      "id": "scroll_threshold",
      "label": "Show After Scroll (pixels)",
      "min": 200,
      "max": 2000,
      "step": 100,
      "default": 800,
      "info": "Bar appears after user scrolls this many pixels"
    }
  ],
  "presets": [
    {
      "name": "Sticky CTA Bar - SkillShift",
      "category": "Conversion"
    }
  ]
}
{% endschema %}
