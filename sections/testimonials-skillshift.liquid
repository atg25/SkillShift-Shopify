{% comment %}
  Testimonials - SkillShift Custom
  
  Displays customer testimonials in a responsive grid with:
  - Star ratings
  - Quote styling
  - Customer names and locations
  - Glass morphism card design
{% endcomment %}

<section class="section-padding" style="background: var(--white);">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="text-center mb-3xl">
        <h2 class="section-title" style="color: var(--navy-deep);">{{ section.settings.heading }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="section-description" style="color: var(--card-text);">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="grid grid-auto-fit gap-xl" style="align-items: stretch;">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'testimonial' -%}
            <div class="card testimonial-card" {{ block.shopify_attributes }}>
              {%- if block.settings.rating > 0 -%}
                <div class="testimonial-rating">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      <i class="fas fa-star"></i>
                    {%- else -%}
                      <i class="far fa-star"></i>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              
              {%- if block.settings.quote != blank -%}
                <p class="testimonial-quote">
                  {{ block.settings.quote }}
                </p>
              {%- endif -%}
              
              <div class="testimonial-author">
                {%- if block.settings.author_name != blank -%}
                  <p class="testimonial-name">{{ block.settings.author_name }}</p>
                {%- endif -%}
                {%- if block.settings.author_location != blank -%}
                  <p class="testimonial-location">{{ block.settings.author_location }}</p>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials - SkillShift",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What Our Students Say"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Join thousands of professionals who've transformed their careers"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial Quote",
          "default": "This course completely changed my career trajectory. The instructors are knowledgeable and the content is incredibly practical."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Sarah Johnson"
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Location or Title",
          "default": "San Francisco, CA",
          "info": "Can be location, job title, or company"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials - SkillShift",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "This course completely changed my career trajectory. The instructors are knowledgeable and the content is incredibly practical. I landed my dream job within 3 months!",
            "author_name": "Sarah Johnson",
            "author_location": "Software Engineer, San Francisco"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The 1-on-1 coaching was invaluable. My coach helped me identify my strengths and create a personalized career plan. Best investment I've made in myself.",
            "author_name": "Michael Chen",
            "author_location": "Product Manager, New York"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "I was skeptical at first, but the quality of instruction exceeded my expectations. The course materials are up-to-date and the community support is amazing.",
            "author_name": "Emily Rodriguez",
            "author_location": "Data Analyst, Austin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
