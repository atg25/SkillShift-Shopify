          "default": "Expert Instructors"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Learn from industry professionals with years of real-world experience"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Propositions - SkillShift",
      "category": "Benefits",
      "blocks": [
        {
          "type": "value_prop",
          "settings": {
            "icon": "graduation-cap",
